<launch>
  <!-- RViz viewer for MAVROS SITL runs and rosbag replays (ROS 1).

       Live sim:    roslaunch comando_planner rviz.launch
       Bag replay:  roslaunch comando_planner rviz.launch replay:=true
                    then play the bag with the clock and loop flags
                    (exact command in docs/MAVROS_SITL.md, section 8).

       Publishes static identity transforms tying together the frames used
       by the different topics: mavros odometry is stamped 'map' (child
       'base_link'), some configs use 'odom', and the planner/target topics
       use 'world'. No TF tree connects them and all origins coincide in
       SITL, so the identity chain odom->world->map makes every topic
       resolvable from any fixed frame. -->

  <arg name="replay"     default="false"
       doc="true when viewing a rosbag: sets /use_sim_time so RViz follows /clock"/>
  <arg name="drone_name" default="px4_drone"/>
  <arg name="rviz_config" default="$(find comando_planner)/rviz/comando_sitl.rviz"/>

  <!-- Always set explicitly: a leftover /use_sim_time=true from a previous
       replay session freezes every node started afterwards (no /clock). -->
  <param name="/use_sim_time" value="$(arg replay)"/>

  <node pkg="tf" type="static_transform_publisher" name="odom_world_bridge"
        args="0 0 0 0 0 0 odom world 100"/>
  <node pkg="tf" type="static_transform_publisher" name="world_map_bridge"
        args="0 0 0 0 0 0 world map 100"/>

  <!-- Drone/target shapes + trails (ROS2-branch parity; works on bags too). -->
  <node pkg="comando_planner" type="comando_rviz_markers.py" name="comando_rviz_markers"/>

  <node pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_config)"/>
</launch>
