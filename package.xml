<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>comando_planner</name>
  <version>0.1.0</version>
  <description>CoManDO MPC planner — ALIPDDP and acados solvers, Crazyflie and PX4 platforms</description>
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Core ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <!-- Crazyflie interface messages -->
  <depend>crazyflie_interfaces</depend>
  <!-- PX4 interface messages (optional — build proceeds without it) -->
  <exec_depend>px4_msgs</exec_depend>
  <!-- Eigen for linear algebra -->
  <depend>eigen</depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>